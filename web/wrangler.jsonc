// Configuración de Cloudflare (Workers con archivos estáticos) para la web de Kopi Client.
// En Cloudflare: Advanced settings → Path = web
// Todo son archivos tal cual, salvo /u/<nombre> (perfil público): eso lo sirve worker.js.
{
  "name": "onyx-client",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/u/*"]
  }
}
