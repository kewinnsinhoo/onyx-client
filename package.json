{
  "name": "onyx-client",
  "productName": "Kopi Client",
  "version": "1.8.3",
  "description": "Launcher de Minecraft de Kopi Studio",
  "main": "src/main/main.js",
  "author": {
    "name": "Kopi Studio",
    "email": "onyx@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "afterPack": "scripts/mac-adhoc-sign.js",
    "appId": "com.onyxstudios.client",
    "productName": "Kopi Client",
    "copyright": "© Kopi Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "onyx.config.json",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/kewinnsinhoo/onyx-client/releases/latest/download"
      },
      {
        "provider": "github",
        "owner": "kewinnsinhoo",
        "repo": "onyx-client",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Kopi-Client-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kopi Client"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Kopi-Client-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "Kopi-Client-${version}.${ext}"
    }
  }
}
